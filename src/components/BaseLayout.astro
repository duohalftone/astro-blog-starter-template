---
import '../styles/global.css';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/stein-favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || 'Gallery test'} />
    <script type="module" src="/gallery.js" defer></script>
  </head>
  <body>
    <slot />
  </body>
</html>
